# Environment variables for Image Processing Service

# Server configuration
HOST=0.0.0.0
PORT=8001
DEBUG=False

# Storage paths
UPLOAD_FOLDER=/tmp/uploads
OUTPUT_FOLDER=/tmp/outputs
MAX_FILE_SIZE=10485760

# Processing configuration
BRACKET_CLASS=13
PADDING_PX=10
CREATE_SUBFOLDERS=True

# CORS
CORS_ORIGINS=*
